<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground>
        <inset
            android:drawable="@drawable/ios_app_icon"
            android:inset="20%" />
    </foreground>
    <!-- Themed icon (Android 13+): silhouette traced from the iOS artwork, same safe-zone inset. -->
