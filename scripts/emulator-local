#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export ANDROID_HOME="$ROOT/.local/android-sdk"
export ANDROID_USER_HOME="$ROOT/.local/android-user"
export ANDROID_EMULATOR_HOME="$ROOT/.local/android-user"
export ANDROID_AVD_HOME="$ROOT/.local/avd"
if [ ! -d "$ANDROID_AVD_HOME/cpa-api37.avd" ]; then
    echo 'Missing cpa-api37 AVD; see docs/migration/environment.md.' >&2
    exit 2
fi
exec "$ANDROID_HOME/emulator/emulator" -avd cpa-api37 -port 5580 \
    -no-window -no-audio -no-snapshot -gpu swiftshader "$@"
